# Arquivos que NAO devem subir para o Cloudflare Workers.
#
# IMPORTANTE: o wrangler le a RAIZ do repositorio como assets directory, entao
# o .git tambem entra na varredura. O pack do .git tem >100 MiB e guarda o blob
# do kof97.zip (27,6 MiB) — sem exclui-lo o deploy falha com "Asset too large".
.git
.wrangler
node_modules
# O Cloudflare limita cada asset a 25 MiB. Os romsets que passam disso NAO
# sobem inteiros; no lugar deles sobem as PARTES (~13 MiB cada, nome
# `<rom>.zip.p1`, `.p2`, ...), que o player baixa e remonta num Blob (campo
# "partes" no jogos.json). Assim tudo sai do MESMO host do site.
jogos/arcade/kof97.zip
jogos/arcade/garou.zip
jogos/arcade/kof2000.zip
jogos/arcade/kof2001.zip
jogos/arcade/kof2002.zip
jogos/arcade/kof2003.zip
jogos/arcade/kof98.zip
jogos/arcade/kof99.zip
jogos/arcade/lastblad.zip
jogos/arcade/lastbld2.zip
jogos/arcade/matrim.zip
jogos/arcade/mslug3.zip
jogos/arcade/mslug4.zip
jogos/arcade/mslug5.zip
jogos/arcade/mslugx.zip
jogos/arcade/preisle2.zip
jogos/arcade/rbff2.zip
jogos/arcade/rotd.zip
jogos/arcade/samsh5fe.zip
jogos/arcade/sengoku3.zip
jogos/arcade/shocktr2.zip
jogos/arcade/svc.zip
